{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "config",
          "screen",
          "theme",
          "source",
          "utility",
          "custom-variant",
          "plugin"
        ]
      }
    ],
    "import-notation": null,
    "at-rule-prelude-no-invalid": null
  }
}
